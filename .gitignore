# ---------------------------------------------------------------------------
# Secrets and credentials
# Nothing matching these may ever reach the history. Patterns are deliberately
# specific: this repo tracks .json, .txt, .csv and .png as real results, so a
# blanket rule on those extensions would hide the outputs instead.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.secret
*.secrets
secrets/
.secrets/
secrets*.json
secrets*.yaml
secrets*.yml
credentials*.json
credentials*.yaml
credentials*.yml
*credentials.json
service-account*.json
*-serviceaccount.json
.netrc
_netrc
.pypirc
.htpasswd

# Keys and certificates
*.pem
*.key
*.keystore
*.jks
*.p12
*.pfx
*.crt
*.cer
*.der
*.asc
*.gpg
*.pgp
secring.*

# SSH
.ssh/
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk
known_hosts

# Cloud and infrastructure credentials
.aws/
.azure/
.gcloud/
gcloud-*.json
gha-creds-*.json
.kube/
kubeconfig
*.kubeconfig
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
.vault-token
.npmrc
.docker/config.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd

# Packaging and build artifacts
build/
dist/
sdist/
wheels/
*.egg
*.egg-info/
.eggs/
.installed.cfg
MANIFEST
pip-wheel-metadata/
share/python-wheels/

# Test, coverage and profiling
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
.hypothesis/
.benchmarks/
*.prof
*.lprof

# Type checkers, linters, formatters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/
.pylint.d/

# Environment and dependency managers
.venv/
venv/
env/
ENV/
virtualenv/
.virtualenv/
.python-version
.pdm-python
.pdm-build/
__pypackages__/
pip-log.txt
pip-delete-this-directory.txt

# Notebooks
.ipynb_checkpoints/
*-checkpoint.ipynb
profile_default/
ipython_config.py

# Caches this project's tooling leaves behind
.cache/
.matplotlib/

# ---------------------------------------------------------------------------
# Local scratch, logs and data that should not be shared
# Simulation results under outputs/ are tracked on purpose and stay tracked.
# ---------------------------------------------------------------------------
scratch/
scratchpad/
tmp/
.tmp/
local/
*.local
*.local.*
*.log
logs/
*.bak
*.orig
*.rej
*.pid
*.sqlite
*.sqlite3
*.db

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.spyderproject
.spyproject
.ropeproject
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# Operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.fseventsd
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
